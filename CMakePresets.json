{
  "version": 8,
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "configurePresets": [
    {
      "name": "config-debug",
      "displayName": "Configure (Debug)",
      "description": "Configure CerebralRelations for debug build",
